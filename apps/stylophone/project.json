{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "stylophone",
  "projectType": "application",
  "sourceRoot": "apps/stylophone/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/stylophone"],
      "options": {
        "command": "tsc -p apps/stylophone/tsconfig.json && vite build --config apps/stylophone/vite.config.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/stylophone/vite.config.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config apps/stylophone/vite.config.ts"
      }
    }
  }
}
