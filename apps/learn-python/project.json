{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "learn-python",
  "projectType": "application",
  "sourceRoot": "apps/learn-python",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/learn-python"],
      "options": {
        "command": "node scripts/build-learn-python.mjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/learn-python/vite.config.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config apps/learn-python/vite.config.ts"
      }
    }
  }
}
