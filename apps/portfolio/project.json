{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "portfolio",
  "projectType": "application",
  "sourceRoot": "apps/portfolio/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/portfolio"],
      "options": {
        "command": "pnpm gen:blogs && tsc -b apps/portfolio/tsconfig.json && vite build --config apps/portfolio/vite.config.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm gen:blogs && vite --config apps/portfolio/vite.config.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config apps/portfolio/vite.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/portfolio"
      }
    }
  }
}
