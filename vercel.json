{
  "outputDirectory": "dist/deploy",
  "headers": [
    {
      "source": "/bob",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/apps/bob/:path*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; media-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bob",
      "missing": [{ "type": "query", "key": "state" }, { "type": "query", "key": "code" }, { "type": "query", "key": "error" }],
      "destination": "/apps/bob",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/bob", "destination": "/bob/index.html" },
    { "source": "/about", "destination": "/api/page?route=about" },
    { "source": "/labs", "destination": "/api/page?route=labs" },
    { "source": "/blogs", "destination": "/api/page?route=blogs" },
    { "source": "/blogs/:slug", "destination": "/api/page?slug=:slug" },
    { "source": "/contact", "destination": "/api/page?route=contact" },
    { "source": "/apps", "destination": "/api/page?route=apps" },
    { "source": "/apps/", "destination": "/api/page?route=apps" },
    { "source": "/apps/:app", "destination": "/apps/:app/index.html" },
    { "source": "/apps/:app/", "destination": "/apps/:app/index.html" },
    { "source": "/apps/:app/(.*)", "destination": "/apps/:app/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
